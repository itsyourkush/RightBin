# Application Configuration
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=True

# Database Configuration
DATABASE_PATH=data/waste_classification.db

# Classification Service Settings
MODEL_PATH=ml/artifacts/waste_classifier.keras
CONFIDENCE_THRESHOLD=0.60
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp
MAX_IMAGE_SIZE_MB=5

# Gamification Scoring Settings
POINTS_ACCEPTED_CLASSIFICATION=10
POINTS_FIRST_SCAN_OF_DAY=5
POINTS_DAILY_CHALLENGE_BONUS=20
POINTS_REFERRAL_BONUS=50
POINTS_SPIN_MIN=5
POINTS_SPIN_MAX=25
SPIN_COOLDOWN_HOURS=24
TREE_AWARD_POINTS_THRESHOLD=500

# Security
SESSION_EXPIRY_DAYS=7

# External MySQL / MariaDB Server Sync Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=smart_waste_db
MYSQL_SSL=False
# Optional connection URI (overrides individual parameters if provided):
# MYSQL_URI=mysql://user:password@host:3306/smart_waste_db?ssl=true
